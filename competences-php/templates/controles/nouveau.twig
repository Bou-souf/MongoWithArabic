{% extends 'base.twig' %}
{% block contenu %}
<h1 class="h3 mb-3">Nouveau contrôle</h1>
<div class="row"><div class="col-lg-8 col-xl-6">
<div class="card"><div class="card-body">
  <form method="post" action="/controles" enctype="multipart/form-data" id="formNouveau">
    {% include 'partials/csrf.twig' %}
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Classe *</label>
        <select class="form-select" name="classe" required>{% for c in classes %}<option value="{{ c.id }}" {{ classe_id == c.id ? 'selected' }}>{{ c.nom }}</option>{% endfor %}</select></div>
      <div class="col-md-6"><label class="form-label">Matière *</label>
        <input class="form-control" name="matiere" list="listeMatieres" required placeholder="ex. Mathématiques">
        <datalist id="listeMatieres">{% for m in matieres %}<option value="{{ m }}">{% endfor %}</datalist></div>
      <div class="col-md-8"><label class="form-label">Titre *</label><input class="form-control" name="titre" required placeholder="ex. Contrôle n°2 — Équations"></div>
      <div class="col-md-4"><label class="form-label">Date</label><input class="form-control" type="date" name="date" value="{{ aujourdhui }}"></div>
      <div class="col-md-4"><label class="form-label">Noté sur</label><input class="form-control" type="number" step="0.5" name="note_sur" value="20"></div>
      <div class="col-12"><label class="form-label">Sujet du contrôle (PDF) *</label>
        <input class="form-control" type="file" name="pdf" accept="application/pdf,.pdf" required>
        <small class="text-muted">Le texte du PDF est analysé pour découper les questions et en déduire les compétences évaluées.</small></div>
      <div class="col-12"><label class="form-label">Notes des élèves (Excel / CSV) — facultatif</label>
        <input class="form-control" type="file" name="excel" accept=".xlsx,.xls,.csv,.ods">
        <small class="text-muted">Vous pourrez aussi l'importer plus tard. Colonnes : Nom, Prénom (ou « Nom et prénom »), Note.</small></div>
      <div class="col-12 form-check ms-2">
        <input class="form-check-input" type="checkbox" name="ia" id="ia" {{ ia_disponible ? 'checked' : 'disabled' }}>
        <label class="form-check-label" for="ia">Analyse avancée par IA (Claude)
          {% if not ia_disponible %}<small class="text-muted">— indisponible : renseignez anthropic_api_key dans config.php</small>{% endif %}</label>
      </div>
    </div>
    <button class="btn btn-primary mt-3" id="btnAnalyser"><i class="bi bi-magic"></i> Analyser le contrôle</button>
  </form>
</div></div>
</div></div>
{% endblock %}
{% block scripts %}
<script>
  document.getElementById('formNouveau').addEventListener('submit', () => {
    const b = document.getElementById('btnAnalyser');
    b.disabled = true; b.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Analyse en cours…';
  });
</script>
{% endblock %}
