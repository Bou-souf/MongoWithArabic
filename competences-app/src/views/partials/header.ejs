<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titre !== 'undefined' ? titre + ' · ' : '' %>Suivi des compétences</title>
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/public/style.css" rel="stylesheet">
</head>
<body>
<% if (user) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
  <div class="container-fluid">
    <a class="navbar-brand fw-semibold" href="/"><i class="bi bi-mortarboard"></i> Compétences</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/"><i class="bi bi-house"></i> Accueil</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/classes') ? 'active' : '' %>" href="/classes"><i class="bi bi-people"></i> Classes</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/controles') ? 'active' : '' %>" href="/controles"><i class="bi bi-file-earmark-pdf"></i> Contrôles</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/statistiques') ? 'active' : '' %>" href="/statistiques"><i class="bi bi-graph-up"></i> Statistiques</a></li>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/alertes') ? 'active' : '' %>" href="/alertes"><i class="bi bi-exclamation-triangle"></i> Alertes</a></li>
        <% if (user.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link <%= path.startsWith('/admin') ? 'active' : '' %>" href="/admin/utilisateurs"><i class="bi bi-shield-lock"></i> Utilisateurs</a></li>
        <% } %>
      </ul>
      <div class="d-flex align-items-center gap-2 text-white">
        <a class="text-white text-decoration-none" href="/profil"><i class="bi bi-person-circle"></i> <%= user.nom %></a>
        <span class="badge bg-light text-primary"><%= user.role === 'admin' ? 'Admin' : 'Professeur' %></span>
        <form method="post" action="/logout" class="ms-2">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Déconnexion</button>
        </form>
      </div>
    </div>
  </div>
</nav>
<% } %>
<main class="container-fluid px-3 px-lg-4 pb-5">
<% for (const f of flash) { %>
  <div class="alert alert-<%= f.type %> alert-dismissible fade show" role="alert">
    <%= f.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
