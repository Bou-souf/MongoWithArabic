<%- include('../partials/header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-0">Questions et compétences</h1>
    <span class="text-muted"><%= controle.titre %> · <%= controle.matiere %> · <%= controle.classe.nom %></span>
  </div>
  <% if (controle.fichierPdf) { %><a class="btn btn-outline-secondary" href="/controles/<%= controle._id %>/pdf" target="_blank"><i class="bi bi-file-earmark-pdf"></i> Voir le PDF</a><% } %>
</div>
<div class="alert alert-info small">
  Le système a proposé une ou plusieurs compétences par question. Corrigez-les si nécessaire : <strong>une compétence par ligne</strong>.
  Utilisez le même libellé pour une compétence évaluée dans plusieurs questions : elle n'apparaîtra qu'une fois dans la grille d'évaluation.
</div>
<form method="post" action="/controles/<%= controle._id %>/competences">
  <%- include('../partials/csrf') %>
  <div class="row g-3">
    <div class="col-lg-9">
      <div class="card"><div class="card-body p-0">
        <table class="table align-middle mb-0" id="tableQuestions">
          <thead class="table-light"><tr><th style="width:90px">N°</th><th>Énoncé</th><th style="width:80px">Barème</th><th style="width:32%">Compétences (une par ligne)</th><th style="width:40px"></th></tr></thead>
          <tbody>
          <% controle.questions.forEach((q, i) => { %>
            <tr>
              <td><input class="form-control form-control-sm" name="questions[<%= i %>][numero]" value="<%= q.numero %>"></td>
              <td><textarea class="form-control form-control-sm enonce" rows="2" name="questions[<%= i %>][enonce]"><%= q.enonce %></textarea></td>
              <td><input class="form-control form-control-sm" name="questions[<%= i %>][bareme]" value="<%= q.bareme ?? '' %>"></td>
              <td><textarea class="form-control form-control-sm comp" rows="<%= Math.max(2, q.competences.length) %>" name="questions[<%= i %>][competences]"><%= q.competences.join('\n') %></textarea></td>
              <td><input class="form-check-input" type="checkbox" name="questions[<%= i %>][supprimer]" title="Supprimer"></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div></div>
      <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="ajouterQuestion"><i class="bi bi-plus"></i> Ajouter une question</button>
      <div class="mt-3 d-flex gap-2">
        <button class="btn btn-outline-primary" name="suite" value="detail">Enregistrer</button>
        <button class="btn btn-primary" name="suite" value="evaluation">Enregistrer et évaluer les élèves <i class="bi bi-arrow-right"></i></button>
      </div>
    </div>
    <div class="col-lg-3">
      <div class="card"><div class="card-body">
        <h2 class="h6">Compétences déjà utilisées en <%= controle.matiere %></h2>
        <p class="small text-muted">Cliquez dans une case « Compétences » puis sur une suggestion pour l'ajouter.</p>
        <% for (const s of suggestions) { %><button type="button" class="btn btn-sm btn-light border mb-1 me-1 suggestion"><%= s %></button><% } %>
      </div></div>
    </div>
  </div>
</form>
<script>
  let derniere = null;
  document.addEventListener('focusin', e => { if (e.target.classList.contains('comp')) derniere = e.target; });
  document.querySelectorAll('.suggestion').forEach(b => b.addEventListener('click', () => {
    if (!derniere) return;
    const v = derniere.value.trim();
    derniere.value = (v ? v + '\n' : '') + b.textContent.trim();
    derniere.rows = Math.max(2, derniere.value.split('\n').length);
    derniere.focus();
  }));
  let n = <%= controle.questions.length %>;
  document.getElementById('ajouterQuestion').addEventListener('click', () => {
    const tr = document.createElement('tr');
    const i = n++;
    tr.innerHTML = `<td><input class="form-control form-control-sm" name="questions[${i}][numero]" value="${i + 1}"></td>
      <td><textarea class="form-control form-control-sm enonce" rows="2" name="questions[${i}][enonce]"></textarea></td>
      <td><input class="form-control form-control-sm" name="questions[${i}][bareme]"></td>
      <td><textarea class="form-control form-control-sm comp" rows="2" name="questions[${i}][competences]"></textarea></td>
      <td><input class="form-check-input" type="checkbox" name="questions[${i}][supprimer]"></td>`;
    document.querySelector('#tableQuestions tbody').appendChild(tr);
  });
</script>
<%- include('../partials/footer') %>
